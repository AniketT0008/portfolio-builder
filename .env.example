# ─────────────────────────────────────────────────────────────
# ProjectForge AI — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# On Vercel: Project Settings → Environment Variables (Production + Preview).
# ─────────────────────────────────────────────────────────────

# Supabase ────────────────────────────────────────────────────
# Dashboard → Project Settings → API
# URL must resolve in DNS (paused/deleted projects break all login).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Legacy anon JWT (starts with eyJ...) OR new sb_publishable_... key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY. Never expose to the browser.
# Used for privileged storage / admin tasks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini ───────────────────────────────────────────────
# Free API key from https://aistudio.google.com/apikey
# SERVER ONLY — never expose to the browser.
GEMINI_MODEL=your-gemini-api-key
# Optional model name overrides (defaults shown)
GEMINI_MODEL_NAME=gemini-2.5-flash
GEMINI_MODEL_HEAVY=gemini-2.5-flash
# Optional: override the OpenAI-compatible endpoint base URL
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# App ─────────────────────────────────────────────────────────
# Used for OAuth + email-confirm redirects. No trailing slash.
# Local:  http://localhost:3000
# Prod:   https://portfolio-builder-fawn.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub (optional) ───────────────────────────────────────────
# A classic/fine-grained PAT raises the public GitHub API rate limit
# when ingesting public repositories. Read-only, public repo scope is enough.
# This is NOT the GitHub OAuth app secret (that lives only in Supabase Auth).
GITHUB_TOKEN=
